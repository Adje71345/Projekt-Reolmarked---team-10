<UserControl x:Class="Reolmarked.View.SaleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <!-- ===== Styles: kort+ primær knap + slette-cirkel ===== -->
    <UserControl.Resources>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="28"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="0" BlurRadius="8" Opacity="0.08"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#0B74C4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="12" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CircleDeleteButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Content" Value="×"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="16"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#FAFAFA" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Salg" Margin="6,0,0,12"
                   FontSize="28" FontWeight="SemiBold" Foreground="#111827"/>

        <!-- Hovedkort -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Scan-linje -->
                <Border CornerRadius="18" Background="#F6F7FB" BorderBrush="#E5E7EB" BorderThickness="1" Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="280"/>
                            <!-- plads til live preview -->
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" Margin="0,0,10,0"
                 Text="{Binding BarCode, UpdateSourceTrigger=PropertyChanged}"
                 Padding="10" FontSize="15"
                 Background="White" BorderBrush="#E5E7EB" BorderThickness="1">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding AddSaleLineCommand}"/>
                            </TextBox.InputBindings>

                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <Grid>
                                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"/>
                                        <ScrollViewer Margin="8,6" x:Name="PART_ContentHost"/>
                                        <TextBlock x:Name="Watermark"
                                   Text="Scan eller indtast stregkode…"
                                   Foreground="#9CA3AF"
                                   Margin="14,8,0,0"
                                   IsHitTestVisible="False"
                                   Visibility="Collapsed"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter TargetName="Watermark" Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>

                        <Button Grid.Column="1"
                Style="{StaticResource PrimaryButton}"
                MinWidth="90" Height="40"
                Command="{Binding AddSaleLineCommand}"
                Content="Tilføj" FontSize="16"/>

                        <!-- Live stregkode-preview af den indtastede/scannede tekst -->
                        <Border Grid.Column="2" CornerRadius="10" BorderBrush="#E5E7EB" BorderThickness="1" Padding="6" Background="White" Margin="10,0,0,0">
                            <Image Source="{Binding BarcodePreview}" Stretch="Uniform" />
                        </Border>
                    </Grid>
                </Border>


                <!-- Antal/Samlet pris + Betal -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="260"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontSize="16" Margin="0,0,24,0">
                            <Run Text="Antal: " FontWeight="SemiBold"/>
                            <Run Text="{Binding DisplayQuantity, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock FontSize="16">
                            <Run Text="Samlet pris: " FontWeight="SemiBold"/>
                            <Run Text="{Binding DisplayTotalPrice, Mode=OneWay, StringFormat={}{0:N2} kr.}"/>
                        </TextBlock>
                    </StackPanel>

                    <Button Grid.Column="1" Height="40"
                            Style="{StaticResource PrimaryButton}"
                            Content="Betal"
                            Command="{Binding PayCommand}"
                            Margin="116,0,0,0" FontSize="16"/>

                </Grid>

                <!-- Tabel med linjer -->
                <Border Grid.Row="4" CornerRadius="18" BorderBrush="#E5E7EB" BorderThickness="1" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- søgefelt -->
                            <RowDefinition Height="8"/>
                            <!-- lille spacer -->
                            <RowDefinition Height="*"/>
                            <!-- tabellen -->
                        </Grid.RowDefinitions>

                        <!-- Søgefelt: binder til SaleViewModel.SearchText -->
                   <TextBox Grid.Row="0"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                            Margin="0,0,0,0"
                            Padding="8"
                            FontSize="14"
                            Background="White"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1">
                       <TextBox.Template>
                          <ControlTemplate TargetType="TextBox">
                             <Grid>
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8"/>
                                <ScrollViewer Margin="8,4" x:Name="PART_ContentHost"/>
                                <TextBlock x:Name="Watermark"
                                          Text="Søg i linjer…"
                                          Foreground="#9CA3AF"
                                          Margin="12,6,0,0"
                                          IsHitTestVisible="False"
                                          Visibility="Collapsed"/>
                             </Grid>
                             <ControlTemplate.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter TargetName="Watermark" Property="Visibility" Value="Visible"/>
                                </Trigger>
                             </ControlTemplate.Triggers>
                          </ControlTemplate>
                       </TextBox.Template>
                   </TextBox>

                   <!-- Eksisterende DataGrid -->
                   <DataGrid Grid.Row="2" x:Name="LinesGrid"
                             ItemsSource="{Binding SalesView}"
                             AutoGenerateColumns="False"
                             HeadersVisibility="Column"
                             CanUserAddRows="False" CanUserDeleteRows="False"
                             IsReadOnly="True"
                             GridLinesVisibility="Horizontal"
                             BorderThickness="0" RowHeaderWidth="0">

                   <DataGrid.Resources>
                          <Style TargetType="DataGridColumnHeader">
                              <Setter Property="FontWeight" Value="SemiBold"/>
                              <Setter Property="Foreground" Value="#4B5563"/>
                              <Setter Property="Padding" Value="8,6"/>
                          </Style>
                          <Style TargetType="DataGridRow">
                              <Setter Property="Padding" Value="4"/>
                          </Style>
                          <Style x:Key="CellPadRight24" TargetType="DataGridCell">
                             <Setter Property="Padding" Value="6,0,24,0"/>
                             <Setter Property="VerticalContentAlignment" Value="Center"/>
                          </Style>
                   </DataGrid.Resources>

                   <!-- Kolonner -->
                   <DataGrid.Columns>
                            <!-- Reol -->
                          <DataGridTextColumn Header="Reol"
                                              Binding="{Binding RackId}"
                                              Width="100"
                                              CellStyle="{StaticResource CellPadRight24}"/>

                             <!-- Pris -->
                          <DataGridTextColumn Header="Pris"
                                              Binding="{Binding Price, StringFormat={}{0:N0}}"
                                              Width="120"
                                              CellStyle="{StaticResource CellPadRight24}"/>

                          <!-- Scan-kode: tekst + billede + slet-knap i samme kolonne -->
                          <DataGridTemplateColumn Header="Scan-kode" Width="*">
                             <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                   <Grid>
                                      <Grid.ColumnDefinitions>
                                          <ColumnDefinition Width="Auto"/>
                                          <ColumnDefinition Width="Auto"/>
                                          <ColumnDefinition Width="Auto"/>
                                          <ColumnDefinition Width="Auto"/>
                                          <ColumnDefinition Width="Auto"/>
                                      </Grid.ColumnDefinitions>

                                      <!-- scankode-tekst -->
                                      <TextBlock Grid.Column="0"
                                           Text="{Binding ScanCode}"
                                           VerticalAlignment="Center"/>

                                      <!-- afstand tekst->billede -->
                                      <Rectangle Grid.Column="1" Width="40" Height="1" Fill="Transparent"/>

                                      <!-- stregkode-billede -->
                                      <Image Grid.Column="2"
                                           Source="{Binding BarcodeImage}"
                                           Height="20"
                                           Stretch="None"
                                           HorizontalAlignment="Left"/>

                                      <!-- afstand billede->kryds -->
                                      <Rectangle Grid.Column="3" Width="320" Height="1" Fill="Transparent"/>

                                      <!-- slet-knap -->
                                      <Button Grid.Column="4"
                                           Style="{StaticResource CircleDeleteButton}"
                                           Command="{Binding DataContext.RemoveSaleLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                           CommandParameter="{Binding}"/>
                                   </Grid>
                                </DataTemplate>
                             </DataGridTemplateColumn.CellTemplate>
                          </DataGridTemplateColumn>
                     </DataGrid.Columns>

                   </DataGrid>
                </Grid>
            </Border>


                <!-- Ryd kurv -->
                <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Ryd kurv"
                            Command="{Binding ClearSaleBasketCommand}"
                            Height="40" MinWidth="120"
                            BorderBrush="#9CA3AF" BorderThickness="1"
                            Background="White" Foreground="#111827" FontSize="16" Width="144">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="12"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
