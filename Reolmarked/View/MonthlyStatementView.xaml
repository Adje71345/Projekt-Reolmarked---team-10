<!-- MonthlyStatementView: Oversigt over månedsopgørelse med filter (år/måned), tabel og total-linje -->
<UserControl x:Class="Reolmarked.View.MonthlyStatementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:helpers="clr-namespace:Reolmarked.ViewModel.Helpers"
             mc:Ignorable="d"
             d:DesignWidth="1200" d:DesignHeight="700"
             Background="#F7F8FB">

    <!-- =======================
         Fælles styles og ressourcer
         ======================= -->
    <UserControl.Resources>

        <!-- Højrejusterede tal-celler til DataGrid -->
        <Style x:Key="CellRight" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0,0,10,0"/>
        </Style>

        <!-- Højrejusterede kolonneoverskrifter (arver header-style) -->
        <Style x:Key="HeaderRight" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="Padding" Value="0,0,10,0"/>
        </Style>

        <!-- Kort-container (visuel ramme til indhold) -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="28"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000" Opacity="0.08" BlurRadius="12" ShadowDepth="1"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Titel-typografi -->
        <Style x:Key="H1" TargetType="TextBlock">
            <Setter Property="FontSize" Value="36"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
        </Style>

        <!-- Label i filterbar (små overskrifter) -->
        <Style x:Key="FilterLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <!-- Standard-stil for “pilleformet” ComboBox (uden custom template) -->
        <Style x:Key="PillCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="29"/>
            <!-- skift til 36/38 hvis ønsket -->
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Padding" Value="10,4"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Størrelse til ÅR-boks -->
        <Style x:Key="YearCombo" BasedOn="{StaticResource PillCombo}" TargetType="ComboBox">
            <Setter Property="Width" Value="66"/>
        </Style>

        <!-- Størrelse til MÅNED-boks -->
        <Style x:Key="MonthCombo" BasedOn="{StaticResource PillCombo}" TargetType="ComboBox">
            <Setter Property="Width" Value="105"/>
        </Style>

        <!-- DataGrid: grundopsætning (kun kolonneoverskrifter, zebra-rækker, ingen gridlines) -->
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="RowHeight" Value="32"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFAFA"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EEF2F7"/>
            <Setter Property="VerticalGridLinesBrush" Value="#EEF2F7"/>
        </Style>

        <!-- DataGrid kolonneoverskrifter -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="Background" Value="#EEF2F7"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,0"/>
        </Style>

        <!-- Celler: center- og venstrejusteret tekst -->
        <Style x:Key="CellCenter" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CellLeft" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- Converter: farver negativt tal rødt i total-linjen -->
        <helpers:NegativeToBrushConverter x:Key="NegativeToBrushConverter"/>

        <!-- Total-linje: beholder (øverste kant + padding justeret ift. scrollbar) -->
        <Style x:Key="TotalsBarBorder" TargetType="Border">
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <!-- Brug objekt-syntaks for Thickness, så x:Static virker -->
            <Setter Property="Padding">
                <Setter.Value>
                    <Thickness Left="0"
                               Top="0"
                               Right="{x:Static SystemParameters.VerticalScrollBarWidth}"
                               Bottom="0"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Total-linje: label “Total” -->
        <Style x:Key="TotalsLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
        </Style>

        <!-- Total-linje: højrejusterede værdier -->
        <Style x:Key="TotalsValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Padding" Value="0,0,10,0"/>
        </Style>

        <!-- Total-linje: dæmpet tekst (genbruger TotalsValue) -->
        <Style x:Key="TotalsMuted" TargetType="TextBlock" BasedOn="{StaticResource TotalsValue}">
            <Setter Property="Foreground" Value="#9CA3AF"/>
        </Style>
    </UserControl.Resources>

    <!-- =======================
         Layout: Header, undertekst, tabel + total
         ======================= -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Row 0: header -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: undertekst -->
            <RowDefinition Height="*"/>
            <!-- Row 2: tabel -->
        </Grid.RowDefinitions>

        <!-- HEADER: Titel (venstre) + År/Måned-filtre (højre) -->
        <Grid Grid.Row="0" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Titel -->
            <TextBlock Text="Månedsopgørelse"
                       FontSize="26"
                       FontWeight="SemiBold"
                       Foreground="#0F172A"
                       VerticalAlignment="Center"
                       LineStackingStrategy="BlockLineHeight"
                       LineHeight="34"/>

            <!-- Filtersektion: År + Måned -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="16,0,0,0">

                <!-- År -->
                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                    <TextBlock Text="År:" Style="{StaticResource FilterLabel}"/>
                    <ComboBox Style="{StaticResource YearCombo}"
                              ItemsSource="{Binding Years}"
                              SelectedItem="{Binding SelectedYear, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <!-- Måned -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Måned:" Style="{StaticResource FilterLabel}"/>
                    <ComboBox Style="{StaticResource MonthCombo}"
                              ItemsSource="{Binding Months}"
                              SelectedItem="{Binding SelectedMonth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- UNDERTEKST: “Afregning · {Måned År}” -->
        <TextBlock Grid.Row="1"
                   Margin="0,0,0,8"
                   Foreground="#6B7280"
                   FontSize="14">
            <Run Text="Afregning · "/>
            <Run Text="{Binding PeriodText, Mode=OneWay}"/>
        </TextBlock>

        <!-- HOVEDKORT: DataGrid + fast total-fod -->
        <Border Grid.Row="2"
                CornerRadius="12"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Padding="0,0,0,12"
                Margin="0,16,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <!-- DataGrid (rækker scroller) -->
                    <RowDefinition Height="Auto"/>
                    <!-- Totals footer (fast) -->
                </Grid.RowDefinitions>

                <!-- TABEL: Månedsopgørelse pr. lejer -->
                <DataGrid Grid.Row="0"
                          ItemsSource="{Binding Rows}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          MaxHeight="420"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.CanContentScroll="True"
                          EnableRowVirtualization="True"
                          MinRowHeight="32">

                    <!-- Kolonner (bredder afspejles i total-linjen) -->
                    <DataGrid.Columns>

                        <!-- Lejer-navn (venstrejusteret, tooltip ved lange navne) -->
                        <DataGridTextColumn Header="Lejer" Width="3*"
                                            Binding="{Binding LejerNavn}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellLeft}">
                                    <Setter Property="ToolTipService.ShowDuration" Value="15000"/>
                                    <Setter Property="ToolTip" Value="{Binding LejerNavn}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Antal reoler (højrejusteret tal) -->
                        <DataGridTextColumn Header="Antal reoler" Width="1.8*"
                                            HeaderStyle="{StaticResource HeaderRight}"
                                            Binding="{Binding AntalReoler}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellRight}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- TotalSalg (højrejusteret tal, tusindtals-separator) -->
                        <DataGridTextColumn Header="TotalSalg" Width="1.8*"
                                            HeaderStyle="{StaticResource HeaderRight}"
                                            Binding="{Binding TotalSalg, StringFormat={}{0:N0}}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellRight}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Kommission (højrejusteret tal) -->
                        <DataGridTextColumn Header="Kommission" Width="1.8*"
                                            HeaderStyle="{StaticResource HeaderRight}"
                                            Binding="{Binding Kommission, StringFormat={}{0:N0}}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellRight}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- ReolLeje (højrejusteret tal) -->
                        <DataGridTextColumn Header="ReolLeje" Width="1.8*"
                                            HeaderStyle="{StaticResource HeaderRight}"
                                            Binding="{Binding ReolLeje, StringFormat={}{0:N0}}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellRight}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Nettoresultat (højrejusteret tal) -->
                        <DataGridTextColumn Header="Nettoresultat" Width="1.8*"
                                            HeaderStyle="{StaticResource HeaderRight}"
                                            Binding="{Binding Nettoresultat, StringFormat={}{0:N0}}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellRight}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                    </DataGrid.Columns>
                </DataGrid>

                <!-- TOTAL-LINJE: Fast footer der matcher kolonnebredder -->
                <Border Grid.Row="1" Style="{StaticResource TotalsBarBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="1.8*"/>
                            <ColumnDefinition Width="1.8*"/>
                            <ColumnDefinition Width="1.8*"/>
                            <ColumnDefinition Width="1.8*"/>
                            <ColumnDefinition Width="1.8*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Label “Total” -->
                        <TextBlock Grid.Column="0" Text="Total" Style="{StaticResource TotalsLabel}"/>

                        <!-- Total: Antal reoler -->
                        <TextBlock Grid.Column="1"
                                   Style="{StaticResource TotalsValue}"
                                   Text="{Binding SumAntalReoler, StringFormat={}{0:N0}}"/>

                        <!-- Total: TotalSalg -->
                        <TextBlock Grid.Column="2"
                                   Style="{StaticResource TotalsValue}"
                                   Text="{Binding SumTotalSalg, StringFormat={}{0:N0}}"/>

                        <!-- Total: Kommission -->
                        <TextBlock Grid.Column="3"
                                   Style="{StaticResource TotalsValue}"
                                   Text="{Binding SumKommission, StringFormat={}{0:N0}}"/>

                        <!-- Total: ReolLeje -->
                        <TextBlock Grid.Column="4"
                                   Style="{StaticResource TotalsValue}"
                                   Text="{Binding SumReolLeje, StringFormat={}{0:N0}}"/>

                        <!-- Total: Nettoresultat (farves rød ved negativ via converter) -->
                        <TextBlock Grid.Column="5"
                                   Style="{StaticResource TotalsValue}"
                                   Foreground="{Binding SumNettoresultat, Converter={StaticResource NegativeToBrushConverter}}"
                                   Text="{Binding SumNettoresultat, StringFormat={}{0:N0}}"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

    </Grid>
</UserControl>
