<UserControl x:Class="Reolmarked.View.RackPanels.AddRentContractView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Style="{DynamicResource WhitePanel}">
        <Grid Margin="2,0,-2,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Overskrift -->
            <DockPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Opret lejekontrakt" FontSize="20" FontWeight="SemiBold"/>
                <Button Content="&#x2715;" FontSize="16" Command="{Binding CloseCommand}"
                        DockPanel.Dock="Right" Style="{StaticResource BtnGhostPill}"/>
            </DockPanel>

            <!-- Felter -->
            <StackPanel Grid.Row="1">
                <!-- Reol -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Reol" Style="{StaticResource FormLabel}"/>
                    <TextBox Grid.Column="1" Text="{Binding RackId}" IsReadOnly="True" Style="{StaticResource InputPill}" />
                </Grid>

                <!-- Lejer (vælg fra liste) -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Lejer" Style="{StaticResource FormLabel}"/>
                    <ComboBox Grid.Column="1"
                        ItemsSource="{Binding Renters}"
                        SelectedItem="{Binding SelectedRenter, Mode=TwoWay}"
                        Style="{StaticResource ComboPill}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="{Binding FirstName}" />
                                    <Run Text="{Binding LastName}" />
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                <!-- Lejer-ID -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="160.18"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Lejer-ID" Style="{StaticResource FormLabel}"/>
                    <TextBox Grid.Column="1" Text="{Binding RenterId}" IsReadOnly="True" Style="{StaticResource InputPill}" />
                </Grid>

                <!-- Startdato -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="160.18"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Startdato" Style="{StaticResource FormLabel}"/>
                    <DatePicker Grid.Column="1" SelectedDate="{Binding StartDateTime, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DatePill}"/>
                </Grid>

                <!-- Slutdato + Ingen slutdato -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Slutdato" Style="{StaticResource FormLabel}"/>
                    <StackPanel Grid.Column="1">
                        <DatePicker SelectedDate="{Binding EndDateTime, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding EndDateEnabled}" Style="{StaticResource DatePill}"/>
                        <TextBlock Text="Justeres automatisk til sidste dag i måneden" FontSize="11" Foreground="{DynamicResource TextBrush}" Margin="12,4,0,0"/>
                        <CheckBox Content="Ingen slutdato" IsChecked="{Binding NoEnd}" Margin="12,8,0,0" Foreground="{DynamicResource TextBrush}" FontSize="14"/>
                    </StackPanel>
                </Grid>

                <!-- Betalingsmetode -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Betalingsmetode" Style="{StaticResource FormLabel}"/>
                    <TextBox Grid.Column="1" Text="{Binding PaymentMethodName, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource InputPill}" />
                </Grid>
            </StackPanel>

            <!-- Opret lejekontrakt -->
            <Button Grid.Row="2" Content="Opret lejekontrakt" Command="{Binding SubmitCommand}"
                    Style="{StaticResource BtnPrimaryPill}" Margin="0,14,0,6"/>
        </Grid>
    </Border>
</UserControl>
