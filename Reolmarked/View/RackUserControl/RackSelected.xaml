<UserControl x:Class="Reolmarked.View.RackUserControl.RackSelected"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:Reolmarked.ViewModel.Helpers">

    <Border Style="{StaticResource WhitePanel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>     <!-- Indhold -->
                <RowDefinition Height="Auto"/>  <!-- Knapper -->
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,0,0,12">

                <!-- Titel -->
                <TextBlock Style="{StaticResource BigTitle}"
                   Text="{Binding Rack.RackId, StringFormat=Reol {0}}"/>

                <!-- Status -->
                <TextBlock Style="{StaticResource FormLabel}" Text="Status"/>
                <Border Style="{StaticResource Pill}">
                    <TextBlock Text="{Binding IsOccupied, Converter={StaticResource BoolToText}}"
                               FontSize="{StaticResource FormFontSize}" FontFamily="{StaticResource FormFont}" 
                               HorizontalAlignment="Center"/>
                </Border>

                <!-- Lejer -->
                <TextBlock Style="{StaticResource FormLabel}" Text="Lejer"/>
                <Border Style="{StaticResource Pill}">
                    <TextBlock Text="{Binding RenterName}" FontSize="{StaticResource FormFontSize}" 
                               FontFamily="{StaticResource FormFont}" HorizontalAlignment="Center"/>
                </Border>

                <!-- Periode -->
                <TextBlock Style="{StaticResource FormLabel}" Text="Periode"/>
                <Border Style="{StaticResource Pill}">
                    <TextBlock Text="{Binding PeriodText}" FontSize="{StaticResource FormFontSize}"
                               FontFamily="{StaticResource FormFont}" HorizontalAlignment="Center"/>
                </Border>

                <!-- Dage tilbage (vises kun hvis der er en slutdato) -->
                <TextBlock Style="{StaticResource FormLabel}" Text="Dage tilbage"
                   Visibility="{Binding DaysLeft, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>
                <Border Style="{StaticResource Pill}"
                Visibility="{Binding DaysLeft, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}">
                    <TextBlock Text="{Binding DaysLeft}" FontSize="{StaticResource FormFontSize}"
                               FontFamily="{StaticResource FormFont}" HorizontalAlignment="Center"/>
                </Border>
            </StackPanel>
            
            <!-- Knapper nederst-->
            <StackPanel Grid.Row="1">
                <Button Style="{StaticResource BtnPrimaryPill}"
                    Content="Opret lejekontrakt"
                    IsEnabled="{Binding IsOccupied, Converter={StaticResource BoolNot}}"
                    Command="{Binding AddContractCommand}"/>

                <Border Height="6" Background="Transparent"/>

                <Button Style="{DynamicResource BtnDangerOutlinePill}"
                    Content="Opsig lejekontrakt"
                    IsEnabled="{Binding IsOccupied}"
                    Command="{Binding EndContractCommand}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
