<UserControl x:Class="Reolmarked.View.AddRenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="360">

    <Border Style="{StaticResource WhitePanel}">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Overskrift -->
                <RowDefinition Height="*"/>     <!-- Form -->
                <RowDefinition Height="Auto"/>  <!-- Knapper -->
            </Grid.RowDefinitions>

            <!-- Overskrift -->
            <DockPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Opret ny lejer" Style="{StaticResource BigTitle}" DockPanel.Dock="Left"/>
                <Button Content="&#x2715;" Command="{Binding CancelCommand}" Style="{StaticResource BtnGhostPill}" DockPanel.Dock="Right"/>
            </DockPanel>

            <!-- Formular -->
            <StackPanel Grid.Row="1">

                <TextBlock Style="{StaticResource FormLabel}" Text="Fornavn"/>
                <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputPill}" Margin="0,4,0,12"/>

                <TextBlock Style="{StaticResource FormLabel}" Text="Efternavn"/>
                <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputPill}" Margin="0,4,0,12"/>

                <TextBlock Style="{StaticResource FormLabel}" Text="Telefonnummer"/>
                <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputPill}" Margin="0,4,0,12"/>
                <TextBlock Text="{Binding PhoneErrorText}" Foreground="Red" FontSize="12" />

                <TextBlock Style="{StaticResource FormLabel}" Text="Email"/>
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputPill}" Margin="0,4,0,12"/>
                <TextBlock Text="{Binding DuplicateErrorText}" Foreground="Red" FontSize="12" />
                
                <TextBlock Style="{StaticResource FormLabel}" Text="Betalingsmetode"/>
                <Border Style="{StaticResource Pill}">
                    <ComboBox ItemsSource="{Binding PaymentMethods}" SelectedValue="{Binding PaymentMethodId}"
                              SelectedValuePath="PaymentMethodId" DisplayMemberPath="Name" 
                              Background="Transparent" BorderThickness="0"
                              FontSize="{StaticResource FormFontSize}" FontFamily="{StaticResource FormFont}" Padding="0"/>
                </Border>
            </StackPanel>

            <!-- opret lejer knap -->
            <Button Grid.Row="2" Content="Opret lejer" Command="{Binding AddRenterCommand}"
                    Style="{StaticResource BtnPrimaryPill}" Margin="0,12,0,0" HorizontalAlignment="Stretch"/>
        </Grid>
    </Border>
</UserControl>

